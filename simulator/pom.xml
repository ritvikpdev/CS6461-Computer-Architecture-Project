<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">


  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.gwu.cs6461</groupId>
  <artifactId>CS6461Simulator</artifactId>
  <version>1.0.0</version>
  <name>CS6461 Basic Machine Simulator</name>
  <description>GWU CS6461 Project – JavaFX-based simulator</description>


  <properties>
    <!-- Match your installed JDK version -->
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- JavaFX Core Libraries -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>22.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>22.0.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <!-- Java Compiler Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>-Xlint:unchecked</arg>
            <arg>-Xlint:deprecation</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- JavaFX Maven Plugin (for mvn javafx:run) -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <!-- This must match your JavaFX main class -->
          <mainClass>edu.gwu.cs6461.ui.SimulatorUI</mainClass>
          <!-- Automatically include all JavaFX modules you use -->
          <launcher>edu.gwu.cs6461.ui.SimulatorUI</launcher>
          <jlinkZipName>cs6461-simulator</jlinkZipName>
          <stripDebug>true</stripDebug>
        </configuration>
      </plugin>

      <!-- JAR Plugin (to build runnable .jar) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <mainClass>edu.gwu.cs6461.ui.SimulatorUI</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <repositories>
    <repository>
      <id>openjfx</id>
      <url>https://maven.openjfx.io/</url>
    </repository>
  </repositories>

</project>
